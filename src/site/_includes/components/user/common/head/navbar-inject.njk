<script>
document.addEventListener('DOMContentLoaded', function() {
    // Find the navbar-inner div
    const navbarInner = document.querySelector('.navbar-inner');
    
    if (navbarInner) {
        // Create navigation container
        const nav = document.createElement('nav');
        nav.className = 'custom-nav-inline';
        nav.innerHTML = `
            <a href="/">Home</a>
            <a href="/vote/">Nominate Future Movies</a>
        `;
        
        // Append to navbar-inner
        navbarInner.appendChild(nav);
    }
});
</script>
